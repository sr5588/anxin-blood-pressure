.month {
  font-size: 42rpx;
  font-weight: 600;
  margin-bottom: 22rpx;
}
.month-arrow {
  min-height: 96rpx;
  min-width: 96rpx;
  font-size: 60rpx;
  padding: 0;
}
.calendar-grid {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  gap: 10rpx 0;
  margin-bottom: 28rpx;
}
.weekday {
  text-align: center;
  font-size: 28rpx;
  color: #8492a4;
  margin-bottom: 12rpx;
}
.date-cell {
  padding: 8rpx 0;
  min-height: 108rpx;
  border-radius: 22rpx;
  background: white;
  color: #3e536b;
  font-size: 34rpx;
  display: flex;
  flex-direction: column;
  gap: 0;
  font-weight: 500;
  line-height: 1.3;
}
.date-cell.selected {
  background: #2c7deb;
  color: white;
}
.day-status {
  font-size: 18rpx;
  height: 26rpx;
  color: #73b59e;
}
.selected .day-status {
  color: #fff;
}
.date-cell[disabled] {
  background: white !important;
  color: #b9c2cd !important;
}
.calendar-bp {
  font-size: 68rpx;
  color: #a7b4c1;
  font-weight: 600;
  margin: 16rpx 0;
}
.theme-dark .date-cell {
  background: var(--surface);
  color: var(--text);
}
.theme-dark .date-cell.selected {
  background: var(--primary);
  color: white;
}
.theme-dark .date-cell[disabled] {
  background: var(--surface) !important;
  color: #667990 !important;
}
.theme-dark .calendar-bp {
  color: var(--muted);
}
