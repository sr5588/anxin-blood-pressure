page {
  background: var(--bg);
  color: var(--text);
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", sans-serif;
  font-size: 36rpx;
  line-height: 1.55;
}
view,
text,
button {
  box-sizing: border-box;
}
button {
  font-size: 38rpx;
  line-height: 1.4;
  font-weight: 600;
  border-radius: 28rpx;
  margin: 0;
  min-height: 112rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 22rpx 28rpx;
  background: var(--soft-blue);
  color: #2674d9;
}
button::after {
  border: 0;
}
button[disabled] {
  background: #e7ebf0 !important;
  color: #8592a4 !important;
}
.primary {
  background: var(--primary);
  color: var(--surface);
  box-shadow: 0 10rpx 24rpx #277dee20;
}
.secondary {
  background: var(--soft-blue);
  color: #286dcc;
}
.ghost {
  background: transparent;
  color: #416488;
}
.danger {
  background: #fff0ea;
  color: #a4472d;
}
.page {
  padding: 28rpx 32rpx 180rpx;
}
.page.no-fab {
  padding-bottom: 64rpx;
}
.eyebrow {
  font-size: 26rpx;
  letter-spacing: 4rpx;
  color: #62809d;
  font-weight: 600;
}
.title {
  font-size: 56rpx;
  line-height: 1.3;
  font-weight: 700;
  letter-spacing: -1rpx;
  margin: 12rpx 0 20rpx;
}
.subtitle,
.muted {
  color: var(--muted);
}
.small {
  font-size: 28rpx;
}
.card {
  background: var(--surface);
  border-radius: 36rpx;
  padding: 32rpx;
  margin: 24rpx 0;
  box-shadow: 0 8rpx 36rpx #263d5505;
}
.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}
.stack {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}
.grid2 {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
}
.section-title {
  font-size: 38rpx;
  font-weight: 650;
  margin: 36rpx 0 16rpx;
}
.tag {
  font-size: 26rpx;
  padding: 10rpx 20rpx;
  border-radius: 99rpx;
  background: #edf6f2;
  color: #398575;
}
.note {
  background: #eef4fd;
  padding: 24rpx;
  border-radius: 24rpx;
  color: #436382;
  font-size: 30rpx;
  margin: 22rpx 0;
}
.notice {
  background: #fff6df;
  color: #775621;
  padding: 26rpx;
  border-radius: 26rpx;
  font-size: 32rpx;
  margin: 22rpx 0;
}
.urgent {
  background: #fff0e9;
  color: #963a20;
  padding: 28rpx;
  border-radius: 28rpx;
  font-size: 34rpx;
  margin: 22rpx 0;
}
.num {
  font-variant-numeric: tabular-nums;
  font-weight: 650;
  letter-spacing: -2rpx;
}
.coral {
  color: var(--coral);
}
.blue {
  color: var(--blue);
}
.divider {
  height: 1rpx;
  background: var(--divider);
  margin: 24rpx 0;
}
.empty {
  text-align: center;
  padding: 44rpx 10rpx;
  color: var(--muted);
}
.empty-icon {
  font-size: 74rpx;
  margin-bottom: 14rpx;
}
.segmented {
  display: flex;
  background: #eaf0f6;
  border-radius: 24rpx;
  padding: 8rpx;
  gap: 4rpx;
  margin: 24rpx 0;
}
.segment {
  flex: 1;
  font-size: 30rpx;
  min-height: 88rpx;
  background: transparent;
  border-radius: 18rpx;
  padding: 12rpx 8rpx;
  color: #63758a;
}
.segment.selected {
  background: var(--surface);
  color: #246fce;
  box-shadow: 0 3rpx 10rpx #2845650a;
}
.pills {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin: 20rpx 0;
}
.pill {
  font-size: 30rpx;
  min-height: 96rpx;
  flex: 1;
  padding: 18rpx;
  background: var(--surface);
  color: #65758a;
  white-space: nowrap;
}
.pill.selected {
  background: #e3efff;
  color: #1768cc;
}
.link-row {
  width: 100%;
  justify-content: space-between;
  text-align: left;
  background: white;
  color: #314359;
  font-weight: 500;
  margin: 8rpx 0;
  min-height: 110rpx;
  font-size: 34rpx;
}
.badge {
  background: #eaf3ff;
  border-radius: 20rpx;
  font-size: 26rpx;
  color: #377cce;
  padding: 6rpx 16rpx;
}
.footer {
  font-size: 26rpx;
  color: #728299;
  line-height: 1.7;
  margin: 30rpx 4rpx;
}
.spacer {
  height: 24rpx;
}

page {
  --bg: #f7f8fa;
  --surface: #ffffff;
  --text: #23344b;
  --muted: #718299;
  --primary: #277dee;
  --blue: #3685e8;
  --coral: #e88470;
  --soft-blue: #edf4ff;
  --divider: #edf0f5;
  --mint: #dff3ea;
  --mint-text: #438d78;
  --warm: #fff4df;
  --warm-text: #8b672e;
}
.page {
  min-height: 100vh;
  background: var(--bg);
  color: var(--text);
}
.theme-dark {
  --bg: #101824;
  --surface: #1b2838;
  --text: #edf3fc;
  --muted: #a1b1c5;
  --primary: #408af0;
  --blue: #83b9ff;
  --coral: #ffa890;
  --soft-blue: #253951;
  --divider: #2d3c50;
  --mint: #22483f;
  --mint-text: #8ed9bc;
  --warm: #3b3427;
  --warm-text: #f2d09b;
}
.theme-dark .title,
.theme-dark .section-title {
  color: var(--text);
}
.theme-dark .subtitle,
.theme-dark .small.muted,
.theme-dark .muted,
.theme-dark .footer {
  color: var(--muted);
}
.theme-dark .eyebrow {
  color: #a2bfdf;
}
.theme-dark .secondary {
  background: var(--soft-blue);
  color: var(--blue);
}
.theme-dark .tag {
  background: var(--mint);
  color: var(--mint-text);
}
.theme-dark .note {
  background: #21354d;
  color: #b9d5f6;
}
.theme-dark .notice {
  background: var(--warm);
  color: var(--warm-text);
}
.theme-dark .urgent {
  background: #492e2c;
  color: #ffc5ad;
}
.theme-dark .badge {
  background: var(--soft-blue);
  color: var(--blue);
}
.theme-dark .segmented {
  background: #182435;
}
.theme-dark .segment {
  color: var(--muted);
}
.theme-dark .segment.selected {
  background: #2a3d53;
  color: #b7d9ff;
}
.theme-dark .pill {
  background: var(--surface);
  color: var(--muted);
}
.theme-dark .pill.selected {
  background: #28476a;
  color: #cae4ff;
}
.theme-dark .link-row {
  background: var(--surface);
  color: var(--text);
}
.theme-dark .ghost {
  color: #a8c8ed;
}
.theme-dark .empty {
  color: var(--muted);
}
.theme-dark button[disabled] {
  background: #263447 !important;
  color: #73879e !important;
}
.primary {
  color: #ffffff;
}
.theme-dark .primary {
  color: #ffffff;
}
