{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "strict": true,
    "noImplicitThis": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["miniprogram-api-typings"],
    "lib": ["ES2020"],
    "outDir": ".build/client"
  },
  "include": ["miniprogram/**/*.ts", "shared/**/*.ts"],
  "exclude": ["miniprogram/shared"]
}
